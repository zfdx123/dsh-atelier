{
  "name": "@zfdx123/dsh-memery",
  "version": "1.0.7",
  "description": "自包含跨会话记忆插件：node:sqlite 工作区记忆库 + 首轮注入/每轮关键词命中 + memory_* 工具 + 设置页记忆浏览器。无外部服务依赖。",
  "license": "MIT",
  "homepage": "https://github.com/zfdx123/dsh-atelier/tree/main/packages/dsh-memery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zfdx123/dsh-atelier.git",
    "directory": "packages/dsh-memery"
  },
  "bugs": {
    "url": "https://github.com/zfdx123/dsh-atelier/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": "^0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@types/node": "^22.20.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "npm run build && node test.mjs",
    "prepare": "node build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
